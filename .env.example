# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_GOOGLE_MAPS_API_KEY: Required for Google Maps Places Autocomplete & Maps JS API.
# Automatically configured via the AI Studio Google Maps setup flow.
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional: Google Sheet sumber data (tab harus bisa dibaca via link / "Publish to web").
# Default: sheet "Travel Planning", tab "TRAVEL PLAN".
# VITE_SHEET_ID="..."
# VITE_SHEET_TAB="TRAVEL PLAN"
# Atau isi langsung URL CSV hasil File > Share > Publish to web:
# VITE_SHEET_CSV_URL="https://docs.google.com/spreadsheets/d/e/.../pub?gid=0&single=true&output=csv"
