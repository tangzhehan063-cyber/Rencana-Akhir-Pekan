},
{
"start": 68.017,
"end": 68.969,
"text": "Ditekan dari dalam.",
"hold": 69.56899999999999
},
{
"start": 69.967,
"end": 70.417,
"text": "Paginya,",
"hold": 70.877
},
{
"start": 70.877,
"end": 72.066,
"text": "satpam berdiri di trotoar",
"hold": 72.066
},
{
"start": 72.066,
"end": 73.895,
"text": "dan menghitung baris jendela gedung itu.",
"hold": 74.49499999999999
},
{
"start": 74.546,
"end": 75.13,
"text": "Cuma ada empat.",
"hold": 75.72999999999999
},
{
"start": 75.992,
"end": 77.41,
"text": "Gedung ini tidak pernah punya lantai lima.",
"hold": 78.00999999999999
},
{
"start": 78.288,
"end": 79.702,
"text": "Tapi di jendela paling atas,",
"hold": 80.16
},
{
