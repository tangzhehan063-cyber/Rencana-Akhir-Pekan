[
{
"start": 0.0,
"end": 2.497,
"text": "Jam sebelas lewat empat puluh tujuh malam,",
"hold": 3.063
},
{
"start": 3.063,
"end": 5.685,
"text": "dan Rudi tinggal sendirian di lantai lima.",
"hold": 6.284999999999999
},
{
"start": 6.523,
"end": 8.068,
"text": "Dia masuk lift dan menekan G.",
"hold": 8.668
},
{
"start": 8.716,
"end": 10.063,
"text": "Tombol empat ditutup lakban,",
"hold": 10.513
},
{
"start": 10.513,
"end": 12.629,
"text": "ada tulisan \"belum jadi\" di atasnya.",
"hold": 13.229
},
{
"start": 13.544,
"end": 15.048,
"text": "Lift tetap berhenti di lantai empat.",
"hold": 15.648
},
{
"start": 15.761,
"end": 17.221,
"text": "Pintunya terbuka ke lantai beton kasar,",
"hold": 17.61
},
{
"start": 17.61,
"end": 19.278,
"text": "dengan kabel menggantung dari langit-langit.",
"hold": 19.878
},
{
"start": 20.143,
"end": 22.098,
"text": "Tirai plastik di ujung sana bergoyang pelan,",
"hold": 22.412
},
{
"start": 22.412,
"end": 23.395,
"text": "padahal tidak ada angin.",
"hold": 23.995
},
{
"start": 24.24,
"end": 25.181,
"text": "Rudi melangkah keluar,",
"hold": 25.181
},
{
"start": 25.181,
"end": 26.808,
"text": "dan pintu lift menutup di belakangnya.",
"hold": 27.408
},
{
"start": 27.954,
"end": 28.799,
"text": "Dia cari tangga darurat",
"hold": 29.184
},
{
"start": 29.184,
"end": 30.152,
"text": "dan turun satu lantai.",
"hold": 30.752000000000002
},
{
"start": 30.872,
"end": 31.64,
"text": "Angka di pintu bawah:",
"hold": 32.065
},
{
"start": 32.065,
"end": 32.298,
"text": "empat.",
"hold": 32.898
},
{
"start": 33.131,
"end": 33.627,
"text": "Turun lagi.",
"hold": 34.125
},
{
"start": 34.125,
"end": 34.323,
"text": "Empat.",
"hold": 34.923
},
{
"start": 35.236,
"end": 35.811,
"text": "Turun lagi,",
"hold": 36.274
},
{
"start": 36.274,
"end": 36.753,
"text": "masih empat.",
"hold": 37.353
},
{
"start": 37.624,
"end": 38.858,
"text": "Tirai plastik tadi sekarang",
"hold": 38.858
},
{
"start": 38.858,
"end": 40.181,
"text": "cuma beberapa langkah darinya.",
"hold": 40.781
},
{
"start": 41.134,
"end": 42.105,
"text": "Di balik plastik itu",
"hold": 42.105
},
{
"start": 42.105,
"end": 43.169,
"text": "ada kepala bulat putih,",
"hold": 43.687
},
{
"start": 43.687,
"end": 45.481,
"text": "sama persis dengan kepalanya sendiri.",
"hold": 46.081
},
{
"start": 46.568,
"end": 47.693,
"text": "Rudi lari ke ujung lorong,",
"hold": 48.08
},
{
"start": 48.08,
"end": 49.769,
"text": "ke satu-satunya lampu yang masih menyala.",
"hold": 50.369
},
{
"start": 50.51,
"end": 52.173,
"text": "Di situ tergantung papan jadwal tukang:",
"hold": 52.773
},
{
"start": 52.822,
"end": 53.295,
"text": "\"Besok,",
"hold": 53.689
},
{
"start": 53.689,
"end": 54.458,
"text": "jam tujuh pagi.",
"hold": 55.058
},
{
"start": 55.112,
"end": 56.465,
"text": "Tutup dinding lantai empat.\"",
"hold": 57.065000000000005
},
{
"start": 57.504,
"end": 58.881,
"text": "Dinding batanya baru setengah jadi,",
"hold": 59.334
},
{
"start": 59.334,
"end": 60.507,
"text": "dan di tengahnya ada cekungan",
"hold": 60.507
},
{
"start": 60.507,
"end": 61.367,
"text": "berbentuk badan orang,",
"hold": 61.935
},
{
"start": 61.935,
"end": 62.861,
"text": "pas seukuran Rudi.",
"hold": 63.461
},
{
"start": 63.668,
"end": 64.44,
"text": "Semennya masih basah,",
"hold": 65.03999999999999
},
{
"start": 65.052,
"end": 66.571,
"text": "dan ada bekas sarung tangan putih",
"hold": 66.571
},
{
"start": 66.571,
"end": 67.286,
"text": "di permukaannya.",
