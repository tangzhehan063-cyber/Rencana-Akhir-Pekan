[
 {
  "i": 0,
  "text": "Jam 11.47 malam."
 },
 {
  "i": 1,
  "text": "Dan Rudi tinggal sendirian di lantai lima."
 },
 {
  "i": 2,
  "text": "Dia masuk lift dan menekan..."
 },
 {
  "i": 3,
  "text": "Tombol empat ditutup lakban."
 },
 {
  "i": 4,
  "text": "Ada tulisan \"belum jadi\" di atasnya."
 },
 {
  "i": 5,
  "text": "Lift tetap berhenti di lantai empat."
 },
 {
  "i": 6,
  "text": "Pintunya terbuka ke lantai beton kasar."
 },
 {
  "i": 7,
  "text": "Dengan kabel menggantung dari langit-langit."
 },
 {
  "i": 8,
  "text": "Tirai plastik di ujung sana bergoyang pelan."
 },
 {
  "i": 9,
  "text": "Padahal tidak ada angin."
 },
 {
  "i": 10,
  "text": "Rudi melangkah keluar dan pintu lift menutup di belakangnya."
 },
 {
  "i": 11,
  "text": "Dia cari tangga darurat."
 },
 {
  "i": 12,
  "text": "Dan turun satu lantai."
 },
 {
  "i": 13,
  "text": "Angka di pintu bawah:"
 },
 {
  "i": 14,
  "text": "Empat."
 },
 {
  "i": 15,
  "text": "Turun lagi."
 },
 {
  "i": 16,
  "text": "Empat."
 },
 {
  "i": 17,
  "text": "Turun lagi."
 },
 {
  "i": 18,
  "text": "Masih empat."
 },
 {
  "i": 19,
  "text": "Tirai plastik tadi sekarang cuma beberapa langkah darinya."
 },
 {
  "i": 20,
  "text": "Di balik plastik itu ada kepala bulat putih."
 },
 {
  "i": 21,
  "text": "Sama persis dengan kepalanya sendiri."
 },
 {
  "i": 22,
  "text": "Rudi lari ke ujung lorong."
 },
 {
  "i": 23,
  "text": "Ke satu-satunya lampu yang masih menyala."
 },
 {
  "i": 24,
  "text": "Di situ tergantung papan jadwal tukang."
 },
 {
  "i": 25,
  "text": "Besok:"
 },
 {
  "i": 26,
  "text": "Jam 7.00 pagi."
 },
 {
  "i": 27,
  "text": "Tutup dinding lantai empat."
 },
 {
  "i": 28,
  "text": "Dinding batanya baru setengah jadi."
 },
 {
  "i": 29,
  "text": "Dan di tengahnya ada cekungan berbentuk badan orang."
 },
 {
  "i": 30,
  "text": "Pas seukuran Rudi."
 },
 {
  "i": 31,
  "text": "Semennya masih basah."
 },
 {
  "i": 32,
  "text": "Dan ada bekas sarung tangan putih di permukaannya."
 },
 {
  "i": 33,
  "text": "Ditekan dari dalam."
 },
 {
  "i": 34,
  "text": "Paginya,"
 },
 {
  "i": 35,
  "text": "Satpam berdiri di trotoar dan menghitung baris jendela gedung itu."
 },
 {
  "i": 36,
  "text": "Cuma ada empat."
 },
 {
  "i": 37,
  "text": "Gedung ini tidak pernah punya lantai lima."
 },
 {
  "i": 38,
  "text": "Tapi di jendela paling atas,"
 },
 {
  "i": 39,
  "text": "lampu meja Rudi masih menyala."
 }
]