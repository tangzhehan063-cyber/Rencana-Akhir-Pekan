[
  {
    "start": 0,
    "end": 2.497,
    "text": "Jam sebelas lewat empat puluh tujuh malam,"
  },
  {
    "start": 3.063,
    "end": 5.685,
    "text": "dan Rudi tinggal sendirian di lantai lima."
  },
  {
    "start": 6.523,
    "end": 8.068,
    "text": "Dia masuk lift dan menekan G."
  },
  {
    "start": 8.716,
    "end": 10.063,
    "text": "Tombol empat ditutup lakban,"
  },
  {
    "start": 10.513,
    "end": 12.629,
    "text": "ada tulisan \"belum jadi\" di atasnya."
  },
  {
    "start": 13.544,
    "end": 15.048,
    "text": "Lift tetap berhenti di lantai empat."
  },
  {
    "start": 15.761,
    "end": 18.114,
    "text": "Pintunya terbuka ke lantai beton kasar, dengan kabel"
  },
  {
    "start": 18.114,
    "end": 19.278,
    "text": "menggantung dari langit-langit."
  },
  {
    "start": 20.143,
    "end": 22.74,
    "text": "Tirai plastik di ujung sana bergoyang pelan, padahal"
  },
  {
    "start": 22.74,
    "end": 23.395,
    "text": "tidak ada angin."
  },
  {
    "start": 24.24,
    "end": 26.294,
    "text": "Rudi melangkah keluar, dan pintu lift menutup di"
  },
  {
    "start": 26.294,
    "end": 26.808,
    "text": "belakangnya."
  },
  {
    "start": 27.954,
    "end": 30.152,
    "text": "Dia cari tangga darurat dan turun satu lantai."
  },
  {
    "start": 30.872,
    "end": 31.64,
    "text": "Angka di pintu bawah:"
  },
  {
    "start": 32.065,
    "end": 32.298,
    "text": "empat."
  },
  {
    "start": 33.131,
    "end": 33.627,
    "text": "Turun lagi."
  },
  {
    "start": 34.125,
    "end": 34.323,
    "text": "Empat."
  },
  {
    "start": 35.236,
    "end": 35.811,
    "text": "Turun lagi,"
  },
  {
    "start": 36.274,
    "end": 36.753,
    "text": "masih empat."
  },
  {
    "start": 37.624,
    "end": 40.181,
    "text": "Tirai plastik tadi sekarang cuma beberapa langkah darinya."
  },
  {
    "start": 41.134,
    "end": 43.169,
    "text": "Di balik plastik itu ada kepala bulat putih,"
  },
  {
    "start": 43.687,
    "end": 45.481,
    "text": "sama persis dengan kepalanya sendiri."
  },
  {
    "start": 46.568,
    "end": 48.967,
    "text": "Rudi lari ke ujung lorong, ke satu-satunya lampu"
  },
  {
    "start": 48.967,
    "end": 49.769,
    "text": "yang masih menyala."
  },
  {
    "start": 50.51,
    "end": 52.173,
    "text": "Di situ tergantung papan jadwal tukang:"
  },
  {
    "start": 52.822,
    "end": 54.458,
    "text": "\"Besok, jam tujuh pagi."
  },
  {
    "start": 55.112,
    "end": 56.465,
    "text": "Tutup dinding lantai empat.\""
  },
  {
    "start": 57.504,
    "end": 58.881,
    "text": "Dinding batanya baru setengah jadi,"
  },
  {
    "start": 59.334,
    "end": 61.367,
    "text": "dan di tengahnya ada cekungan berbentuk badan orang,"
  },
  {
    "start": 61.935,
    "end": 62.861,
    "text": "pas seukuran Rudi."
  },
  {
    "start": 63.668,
    "end": 64.44,
    "text": "Semennya masih basah,"
  },
  {
    "start": 65.052,
    "end": 67.286,
    "text": "dan ada bekas sarung tangan putih di permukaannya."
  },
  {
    "start": 68.017,
    "end": 68.969,
    "text": "Ditekan dari dalam."
  },
  {
    "start": 69.967,
    "end": 70.417,
    "text": "Paginya,"
  },
  {
    "start": 70.877,
    "end": 73.392,
    "text": "satpam berdiri di trotoar dan menghitung baris jendela"
  },
  {
    "start": 73.392,
    "end": 73.895,
    "text": "gedung itu."
  },
  {
    "start": 74.546,
    "end": 75.13,
    "text": "Cuma ada empat."
  },
  {
    "start": 75.992,
    "end": 77.41,
    "text": "Gedung ini tidak pernah punya lantai lima."
  },
  {
    "start": 78.288,
    "end": 79.702,
    "text": "Tapi di jendela paling atas,"
  },
  {
    "start": 80.16,
    "end": 81.808,
    "text": "lampu meja Rudi masih menyala."
  }
]
